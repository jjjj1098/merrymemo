# ── Supabase (필수: 배포할 때) ───────────────────────────────
# Supabase 대시보드 > Project Settings > API 에서 복사
SUPABASE_URL=https://xxxxxxxx.supabase.co
# service_role 키는 서버에서만 쓰여요. 절대 NEXT_PUBLIC_ 을 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# ── 사이트 ──────────────────────────────────────────────────
# 공유 링크와 카톡 미리보기에 쓰는 주소 (끝에 / 없이)
NEXT_PUBLIC_SITE_URL=https://merrymemo.example.com
# 편지가 열리는 시각 (= 편지 쓰기 마감). 테스트할 땐 과거 시각으로 바꿔 보세요.
OPEN_AT=2026-12-25T00:00:00+09:00
# 이 시각이 지나면 크론이 모든 트리·편지를 지워요
PURGE_AT=2027-01-31T00:00:00+09:00
# Vercel 크론이 보내는 비밀 값 (아무 긴 문자열)
CRON_SECRET=

# ── 공유 (선택) ─────────────────────────────────────────────
# 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키 > JavaScript 키
NEXT_PUBLIC_KAKAO_JS_KEY=

# ── 광고 (선택: 승인 전에는 비워 두면 자체 배너가 나와요) ────
NEXT_PUBLIC_ADFIT_UNIT_320x50=
NEXT_PUBLIC_ADFIT_UNIT_300x250=
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_320x50=
NEXT_PUBLIC_ADSENSE_SLOT_300x250=

# ── 문의처 (사이트 페이지에 표시) ──────────────────────────
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=

# 카카오 SDK 주소 (카카오 디벨로퍼스 문서의 최신 버전으로 바꿔도 돼요)
NEXT_PUBLIC_KAKAO_SDK_URL=https://t1.kakaocdn.net/kakao_js_sdk/2.7.2/kakao.min.js
